{
  "name": "school-management",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/dev.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server.cjs",
    "seed": "node --env-file-if-exists=.env server/seed.js",
    "test": "node --test",
    "seed:demo": "node --env-file-if-exists=.env server/seed-demo.js",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongoose": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "vite": "^7.0.0",
    "@vitejs/plugin-react": "^4.5.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
